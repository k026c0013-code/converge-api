{
  "name": "@converge/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "openapi:export": "tsx scripts/export-openapi.ts"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.3.0",
    "@fastify/swagger": "9.9.5",
    "@fastify/type-provider-typebox": "6.3.0",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-mariadb": "7.10.1",
    "@prisma/client": "7.10.1",
    "ajv-formats": "^3.0.1",
    "fastify": "5.12.8",
    "ioredis": "6.0.0",
    "jose": "6.2.18",
    "lib0": "^0.2.120",
    "typebox": "1.4.7",
    "ws": "8.23.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@converge/client": "workspace:*",
    "@types/node": "^24.19.2",
    "@types/ws": "8.18.2",
    "dotenv": "18.0.10",
    "fast-check": "4.11.0",
    "prisma": "7.10.1",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
