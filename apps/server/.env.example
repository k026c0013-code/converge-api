# Copy to .env and fill in. Never commit .env.
HOST=127.0.0.1
PORT=3000
DATABASE_URL=mysql://converge:CHANGE_ME@127.0.0.1:3306/converge_dev
SHADOW_DATABASE_URL=mysql://converge:CHANGE_ME@127.0.0.1:3306/converge_shadow
TEST_DATABASE_URL=mysql://converge:CHANGE_ME@127.0.0.1:3306/converge_test
# HS256 secret for access tokens, >= 32 chars (ADR-0008). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
